    {
      "name": "Read App (8081)",
      "item": [
        {
          "name": "Buscar Account Manager por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tem id', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{readBaseUrl}}/account-managers/{{accountManagerId}}", "host": ["{{readBaseUrl}}"], "path": ["account-managers", "{{accountManagerId}}"] }
          }
        },
        {
          "name": "Buscar Customer por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tem customerId', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.customerId).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{readBaseUrl}}/customers/{{customerId}}", "host": ["{{readBaseUrl}}"], "path": ["customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Listar Customers por Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Resposta é array', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{readBaseUrl}}/customers/by-manager/{{accountManagerId}}?orderBy=totalBalance&page=0&size=20",
              "host": ["{{readBaseUrl}}"],
              "path": ["customers", "by-manager", "{{accountManagerId}}"],
              "query": [
                { "key": "minBalance",      "value": "", "disabled": true },
                { "key": "maxDaysInactive", "value": "", "disabled": true },
                { "key": "orderBy",         "value": "totalBalance" },
                { "key": "page",            "value": "0" },
                { "key": "size",            "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Listar Customers (visão admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Resposta é array', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{readBaseUrl}}/customers?requesterId={{accountManagerId}}&orderBy=totalBalance&page=0&size=20",
              "host": ["{{readBaseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "requesterId",     "value": "{{accountManagerId}}" },
                { "key": "minBalance",      "value": "", "disabled": true },
                { "key": "maxDaysInactive", "value": "", "disabled": true },
                { "key": "orderBy",         "value": "totalBalance" },
                { "key": "page",            "value": "0" },
                { "key": "size",            "value": "20" }
