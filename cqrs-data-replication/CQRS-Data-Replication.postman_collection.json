                      "pm.test('Status 201', () => pm.response.to.have.status(201));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/customers", "host": ["{{writeBaseUrl}}"], "path": ["customers"] },
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"João Investidor\",\n  \"address\": \"Rua das Flores, 123 - São Paulo/SP\",\n  \"age\": 35,\n  \"accountManagerId\": \"{{accountManagerId}}\"\n}" }
              }
            },
            {
              "name": "Atualizar Dados do Customer",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }],
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/customers/{{customerId}}", "host": ["{{writeBaseUrl}}"], "path": ["customers", "{{customerId}}"] },
                "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"name\": \"João Investidor Atualizado\",\n  \"address\": \"Av. Paulista, 1000 - São Paulo/SP\",\n  \"age\": 36\n}" }
              }
            },
            {
              "name": "Atribuir Account Manager",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }],
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/customers/{{customerId}}/account-manager", "host": ["{{writeBaseUrl}}"], "path": ["customers", "{{customerId}}", "account-manager"] },
                "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"accountManagerId\": \"{{accountManagerId}}\"\n}" }
              }
            }
          ]
        },
        {
          "name": "Wallet",
          "item": [
            {
              "name": "Criar Wallet",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
                      "pm.collectionVariables.set('walletId', json.walletId);",
                      "pm.test('Status 201', () => pm.response.to.have.status(201));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/wallets", "host": ["{{writeBaseUrl}}"], "path": ["wallets"] },
                "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\"\n}" }
              }
            },
            {
              "name": "Registrar Transação - DEPOSIT",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/wallets/{{walletId}}/transactions", "host": ["{{writeBaseUrl}}"], "path": ["wallets", "{{walletId}}", "transactions"] },
                "body": { "mode": "raw", "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"value\": 5000.00,\n  \"type\": \"DEPOSIT\",\n  \"exchangeConfirmationId\": \"00000000-0000-0000-0000-000000000001\"\n}" }
              }
            },
            {
              "name": "Registrar Transação - WITHDRAWAL",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/wallets/{{walletId}}/transactions", "host": ["{{writeBaseUrl}}"], "path": ["wallets", "{{walletId}}", "transactions"] },
                "body": { "mode": "raw", "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"value\": 1000.00,\n  \"type\": \"WITHDRAWAL\",\n  \"exchangeConfirmationId\": \"00000000-0000-0000-0000-000000000002\"\n}" }
              }
            }
          ]
        }
      ]
    },
