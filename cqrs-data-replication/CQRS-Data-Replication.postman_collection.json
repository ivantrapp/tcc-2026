{
  "info": {
    "name": "CQRS Data Replication",
    "_postman_id": "cqrs-data-replication-collection",
    "description": "Monolito Write (8080) + Microsserviços Staff/Customer/Wallet (8082-8084) + Read App (8081)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "writeBaseUrl",    "value": "http://localhost:8080" },
    { "key": "staffBaseUrl",    "value": "http://localhost:8082" },
    { "key": "customerBaseUrl", "value": "http://localhost:8083" },
    { "key": "walletBaseUrl",   "value": "http://localhost:8084" },
    { "key": "readBaseUrl",     "value": "http://localhost:8081" },
    { "key": "branchId",         "value": "" },
    { "key": "accountManagerId", "value": "" },
    { "key": "customerId",       "value": "" },
    { "key": "walletId",         "value": "" }
  ],
  "item": [
    {
      "name": "Monolito — Write App (8080)",
      "item": [
        {
          "name": "Branch",
          "item": [
            {
              "name": "Criar Branch",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
                      "pm.collectionVariables.set('branchId', json.branchId);",
                      "pm.test('Status 201', () => pm.response.to.have.status(201));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/branches", "host": ["{{writeBaseUrl}}"], "path": ["branches"] },
                "body": { "mode": "raw", "raw": "{\n  \"region\": \"Sudeste\"\n}" }
              }
            }
          ]
        },
        {
          "name": "Account Manager",
          "item": [
            {
              "name": "Criar Account Manager",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
                      "pm.collectionVariables.set('accountManagerId', json.accountManagerId);",
                      "pm.test('Status 201', () => pm.response.to.have.status(201));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/account-managers", "host": ["{{writeBaseUrl}}"], "path": ["account-managers"] },
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Carlos Silva\",\n  \"branchId\": \"{{branchId}}\",\n  \"isAdmin\": false\n}" }
              }
            },
            {
              "name": "Promover a Admin",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }],
              "request": {
                "method": "PUT",
                "header": [],
                "url": { "raw": "{{writeBaseUrl}}/account-managers/{{accountManagerId}}/admin", "host": ["{{writeBaseUrl}}"], "path": ["account-managers", "{{accountManagerId}}", "admin"] }
              }
            },
            {
              "name": "Atribuir Branch",
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"] } }],
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{writeBaseUrl}}/account-managers/{{accountManagerId}}/branch", "host": ["{{writeBaseUrl}}"], "path": ["account-managers", "{{accountManagerId}}", "branch"] },
                "body": { "mode": "raw", "raw": "{\n  \"accountManagerId\": \"{{accountManagerId}}\",\n  \"branchId\": \"{{branchId}}\"\n}" }
              }
            }
          ]
        },
        {
          "name": "Customer",
          "item": [
            {
              "name": "Criar Customer",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
